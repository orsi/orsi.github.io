{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "vite",
            "type": "node",
            "request": "launch",
            "cwd": "${workspaceRoot}",
            "runtimeExecutable": "npm",
            "runtimeArgs": [
                "run",
                "dev",
            ]
        },
        {
            "name": "chrome",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:5173",
            "webRoot": "${workspaceFolder}",
            "preLaunchTask": "sleep"
        }
    ],
    "compounds": [
        {
            "name": "Vite and Chrome",
            "configurations": [
                "vite",
                "chrome"
            ],
            "stopAll": true
        }
    ]
}